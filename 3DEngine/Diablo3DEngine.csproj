<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Diablo3DEngine</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
	<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
	<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Resources\compositeFragment.glsl" />
    <None Remove="Resources\compositeVertex.glsl" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="TGLView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\compositeFragment.glsl" />
    <EmbeddedResource Include="Resources\compositeVertex.glsl" />
    <EmbeddedResource Include="Resources\vertexShader.glsl" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\fragShader.glsl" />
  </ItemGroup>
</Project>